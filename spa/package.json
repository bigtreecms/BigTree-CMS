{
	"name": "bigtree-spa",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "BigTree CMS admin SPA — React + TypeScript + Tailwind",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"package": "bash ../scripts/package-admin-spa.sh",
		"build:package": "npm run build && npm run package",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test-storybook": "vitest run --project storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-toast": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@tanstack/react-query": "^5.66.0",
		"@tanstack/react-table": "^8.21.2",
		"@tinymce/tinymce-react": "^5",
		"dompurify": "^3.4.10",
		"lucide-react": "^0.475.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-easy-crop": "^5.5.7",
		"react-hook-form": "^7.54.2",
		"react-router-dom": "^7.1.5",
		"sucrase": "^3.35.1",
		"tinymce": "^7",
		"zod": "^3.24.1",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@hookform/resolvers": "^4.1.0",
		"@tailwindcss/vite": "^4.0.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.1",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.6.0",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.1.0",
		"jsdom": "^24.1.3",
		"prettier": "^3.8.3",
		"tailwindcss": "^4.0.6",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.0",
		"vite": "^5.4.14",
		"vite-plugin-static-copy": "^2.3.2",
		"vitest": "^3.2.6",
		"storybook": "^10.4.6",
		"@storybook/react-vite": "^10.4.6",
		"@chromatic-com/storybook": "^5.2.1",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-mcp": "^0.6.0",
		"eslint-plugin-storybook": "^10.4.6",
		"playwright": "^1.61.0",
		"@vitest/browser": "^3.2.6",
		"@vitest/coverage-v8": "^3.2.6"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
