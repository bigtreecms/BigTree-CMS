# Full URL of your BigTree REST API, including any install path prefix.
# The Vite dev server strips /admin/api/v1 from the SPA's fetch path and
# forwards to this URL, so login + cookies round-trip seamlessly.
#
# Examples:
#   VITE_API_TARGET=http://localhost:8080/admin/api/v1
#   VITE_API_TARGET=http://bigtree.com/4.5/admin/api/v1
#   VITE_API_TARGET=https://staging.example.com/admin/api/v1
#
# Trailing slash is tolerated. In DevTools you'll always see the request URL
# as http://localhost:5173/admin/api/v1/... — that's the browser-facing URL;
# the upstream forward is server-side and invisible to the network panel.
VITE_API_TARGET=http://localhost:8080/admin/api/v1
