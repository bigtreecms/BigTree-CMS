{
    "name": "bigtree/cms",
    "description": "BigTree CMS - a content management system built on PHP and MySQL.",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3",
        "ext-gd": "*",
        "ext-json": "*",
        "predis/predis": "^1.1",
        "psr/simple-cache": "^1.0",
        "mrclay/jsmin-php": "^2.4",
        "guzzlehttp/guzzle": "^7.4.5",
        "google/analytics-data": "^0.10.0",
        "wikimedia/less.php": "^4.1",
        "chillerlan/php-qrcode": "^4"
    },
    "scripts": {
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    },
    "extra": {
        "aws/aws-sdk-php": [
            "S3",
            "CloudFront"
        ]
    }
}
